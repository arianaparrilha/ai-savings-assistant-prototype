// Cloudflare Workers deploy: serves the Vite build in ./dist as static assets.
// Later, the real-AI proxy can be added as a Worker script ("main") handling /api/assistant.
{
  "name": "ai-savings-assistant-prototype",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
